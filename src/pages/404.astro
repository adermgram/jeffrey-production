---
import Base from '../layouts/Base.astro';
---
<Base lang="en" title="Page not found" description="This page doesn't exist.">
  <section style="min-height:80svh;display:grid;align-items:center">
    <div class="wrap" style="display:grid;gap:22px;justify-items:start">
      <span class="eyebrow">404</span>
      <h1 class="display">Cut! Wrong scene.</h1>
      <p class="lead">That page doesn’t exist. Let’s get you back to the show.</p>
      <div style="display:flex;gap:12px;flex-wrap:wrap">
        <a class="btn btn-gold arrow" href="/">Back to home</a>
        <a class="btn btn-line" href="/work/">See our work</a>
      </div>
    </div>
  </section>
</Base>
